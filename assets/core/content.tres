[resource]
script = ExtResource("pack")
content_namespace = "core"
version = "1.0.0"
api_version = 1
blocks = Array[ExtResource("block_definition")]([
  ExtResource("block_grass"),
  ExtResource("block_earth"),
  ExtResource("block_stone"),
  ExtResource("block_sand"),
  ExtResource("block_moss"),
  ExtResource("block_timber"),
  ExtResource("block_log"),
  ExtResource("block_leaves"),
  ExtResource("block_paving"),
  ExtResource("block_clay"),
  ExtResource("block_plaster"),
  ExtResource("block_sill"),
  ExtResource("block_bedrock"),
  ExtResource("block_window"),
  ExtResource("block_water"),
  ExtResource("block_slab"),
  ExtResource("block_stairs"),
  ExtResource("block_roof"),
  ExtResource("block_roof_reversed"),
  ExtResource("block_fence"),
  ExtResource("block_wall"),
  ExtResource("block_missing_block"),
  ExtResource("block_grass_flecked"),
  ExtResource("block_earth_pebbled"),
  ExtResource("block_stone_mottled")
])
textures = Dictionary[StringName, Texture2D]({
&"core:pickaxe": ExtResource("texture_pickaxe"),
&"core:sword": ExtResource("texture_sword")
})
deferred_textures = Dictionary[StringName, String]({
&"core:grass": "res://assets/core/textures/grass.png",
&"core:grass_edge": "res://assets/core/textures/grass_edge.png",
&"core:earth": "res://assets/core/textures/earth.png",
&"core:stone": "res://assets/core/textures/stone.png",
&"core:sand": "res://assets/core/textures/sand.png",
&"core:moss": "res://assets/core/textures/moss.png",
&"core:moss_edge": "res://assets/core/textures/moss_edge.png",
&"core:water": "res://assets/core/textures/water.png",
&"core:timber": "res://assets/core/textures/timber.png",
&"core:roof": "res://assets/core/textures/roof.png",
&"core:bark": "res://assets/core/textures/bark.png",
&"core:rings": "res://assets/core/textures/rings.png",
&"core:leaves": "res://assets/core/textures/leaves.png",
&"core:paving": "res://assets/core/textures/paving.png",
&"core:clay": "res://assets/core/textures/clay.png",
&"core:plaster": "res://assets/core/textures/plaster.png",
&"core:sill": "res://assets/core/textures/sill.png",
&"core:window": "res://assets/core/textures/window.png",
&"core:explorer": "res://assets/core/textures/explorer.png",
&"core:tree": "res://assets/core/textures/tree.png",
&"core:shadow": "res://assets/core/textures/shadow.png",
&"core:slab_icon": "res://assets/core/textures/slab.png",
&"core:stairs_icon": "res://assets/core/textures/stairs.png",
&"core:fence_icon": "res://assets/core/textures/fence.png",
&"core:tree_broadleaf": "res://assets/core/textures/tree_broadleaf.png",
&"core:tree_pine": "res://assets/core/textures/tree_pine.png",
&"core:meadow_grass": "res://assets/core/textures/meadow_grass.png",
&"core:flower_gold": "res://assets/core/textures/flower_gold.png",
&"core:flower_rose": "res://assets/core/textures/flower_rose.png",
&"core:flower_lilac": "res://assets/core/textures/flower_lilac.png",
&"core:mountain_pebbles": "res://assets/core/textures/mountain_pebbles.png",
&"core:mountain_shards": "res://assets/core/textures/mountain_shards.png",
&"core:mountain_boulder": "res://assets/core/textures/mountain_boulder.png",
&"core:grass_flecked": "res://assets/core/textures/grass_flecked.png",
&"core:earth_pebbled": "res://assets/core/textures/earth_pebbled.png",
&"core:stone_mottled": "res://assets/core/textures/stone_mottled.png"
})
items = Array[ExtResource("item")]([ExtResource("item_grass"), ExtResource("item_earth"), ExtResource("item_stone"), ExtResource("item_sand"), ExtResource("item_moss"), ExtResource("item_water"), ExtResource("item_timber"), ExtResource("item_slab"), ExtResource("item_stairs"), ExtResource("item_roof"), ExtResource("item_roof_reversed"), ExtResource("item_fence"), ExtResource("item_log"), ExtResource("item_leaves"), ExtResource("item_paving"), ExtResource("item_wall"), ExtResource("item_clay"), ExtResource("item_plaster"), ExtResource("item_sill"), ExtResource("item_window"), ExtResource("item_flower_gold"), ExtResource("item_flower_rose"), ExtResource("item_flower_lilac"), ExtResource("item_pickaxe"), ExtResource("item_sword")])
entities = Dictionary[StringName, ExtResource("scene_definition")]({
&"core:tree": ExtResource("tree"),
&"core:tree_broadleaf": ExtResource("entity_tree_broadleaf"),
&"core:tree_pine": ExtResource("entity_tree_pine"),
&"core:pig": ExtResource("entity_pig"),
&"core:meadow_grass": ExtResource("entity_meadow_grass"),
&"core:flower_gold": ExtResource("entity_flower_gold"),
&"core:flower_rose": ExtResource("entity_flower_rose"),
&"core:flower_lilac": ExtResource("entity_flower_lilac"),
&"core:mountain_pebbles": ExtResource("entity_mountain_pebbles"),
&"core:mountain_shards": ExtResource("entity_mountain_shards"),
&"core:mountain_boulder": ExtResource("entity_mountain_boulder")
})
biomes = Array[ExtResource("biome")]([ExtResource("biome_meadow"), ExtResource("biome_forest"), ExtResource("biome_desert"), ExtResource("biome_mountain")])
recipes = Array[ExtResource("recipe")]([ExtResource("recipe_timber"), ExtResource("recipe_slab"), ExtResource("recipe_stairs"), ExtResource("recipe_fence"), ExtResource("recipe_paving"), ExtResource("recipe_wall"), ExtResource("recipe_roof"), ExtResource("recipe_roof_reversed"), ExtResource("recipe_pickaxe"), ExtResource("recipe_sword")])
crafting_tags = Array[ExtResource("crafting_tag")]([ExtResource("crafting_wood"), ExtResource("crafting_stone"), ExtResource("crafting_roof")])
