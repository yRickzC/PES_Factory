[ext_resource type="Script" uid="uid://cg5cgej82u4pd" path="res://addons/ldk/core/Voxel/Generation/voxel_biome_relief.gd" id="relief"]
[ext_resource type="Script" uid="uid://dmqvfaikkx33i" path="res://addons/ldk/core/Voxel/Generation/voxel_biome.gd" id="script"]
[ext_resource type="Script" path="res://addons/ldk/core/Voxel/Generation/voxel_biome_scatter.gd" id="scatter"]
[ext_resource type="Resource" path="res://assets/core/Biomes/meadow_grass.tres" id="grass"]
[ext_resource type="Resource" path="res://assets/core/Biomes/meadow_flowers.tres" id="flowers"]

[sub_resource type="Resource" id="Relief_meadow"]
script = ExtResource("relief")
base_height = 4.0
amplitude = 1.2
noise_frequency = 0.006
smoothness = 0.65
elevation_limits = Vector2(3, 5)

[resource]
script = ExtResource("script")
key = &"core:meadow"
climate = Vector2(0.02, 0.06)
terrain_relief = SubResource("Relief_meadow")
surface = &"core:grass"
soil = &"core:earth"
bedrock = &"core:stone"
surface_variants = Array[StringName]([&"core:grass_flecked"])
