[sub_resource type="Resource" id="rewards"]
script = ExtResource("drops")
items = Dictionary[StringName, int]({
&"core:fence": 1
})

[sub_resource type="Resource" id="visual"]
script = ExtResource("geometry")
model = ExtResource("model")
connection_arm = ExtResource("arm")

[resource]
script = ExtResource("block")
key = &"core:fence"
legacy_keys = Array[StringName]([&"core:fence_turned"])
geometry = SubResource("visual")
collision = SubResource("collider")
connection_group = &"core:fence"
breakable = SubResource("resistance")
drops = SubResource("rewards")
